# Local deployment ledger only. Keep this file value-free; copy it to the
# ignored .env file before filling values in a protected local environment.
# HF_TOKEN and GH_TOKEN are control-plane credentials and are never Space Settings.
HF_TOKEN=
GH_TOKEN=

# Space Secrets
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
NC_AUTH_JWT_SECRET=
OPS_TOKEN=

# Space Variables
NC_SITE_URL=
NC_DEFAULT_LOCALE=
NOCODB_ARTIFACT_MANIFEST_URL=
NOCODB_ARTIFACT_SLOT=
NOCODB_ARTIFACT_DOWNLOAD_TOKEN=
